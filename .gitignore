# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dist
node_modules
dist/

# Profile
.rspack-profile-*/

# IDE
.idea

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.tanstack
tsconfig.tsbuildinfo

# env files (can opt-in for committing if needed)
.env*

# === ZMENG 专属 ===
# Rust 构建产物（src-tauri，可达数十 GB）
src-tauri/target/

# 打包输出
APP/

# 定制分支依赖：excalidraw（独立 git 仓库，按 CLAUDE.md 前置步骤重新 clone + 构建）
excalidraw/

# 历史误创建的字面 ~ 目录（应为 $HOME/.tauri）
~/

# 构建日志
*.log

# ZCode session data
.zcode/
